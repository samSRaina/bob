# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file — it is in .gitignore.

# --- IBM Bob inference API (used ONLY for FIR entity extraction — "the copilot") ---
# Create an Inference-scoped API key at bob.ibm.com -> API Keys.
BOB_API_KEY=your_bob_api_key_here
BOB_API_BASE_URL=https://api.us-east.bob.ibm.com
# Leave BOB_MODEL blank to auto-discover the first available model from
# GET {BOB_API_BASE_URL}/inference/v1/model/info
BOB_MODEL=
BOB_EXTRACTION_ENABLED=true
BOB_REQUEST_TIMEOUT_SECONDS=25

# --- Database ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5544/cctns_intelligence

# --- Application ---
APP_PORT=8010
APP_ENV=development
CORS_ORIGINS=http://localhost:5199

# --- Embeddings ---
MO_EMBEDDING_MODEL=all-MiniLM-L6-v2
MO_SIMILARITY_THRESHOLD=0.90

# --- Entity resolution ---
ENTITY_FUZZY_THRESHOLD=82
